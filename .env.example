# Hugging Face Hub Configuration
HF_TOKEN=your_huggingface_token_here
HF_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# Application Settings
UPLOAD_DIR=uploads
DATABASE_URL=sqlite:///./data/meetings.db
MAX_FILE_SIZE=100MB

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Comma-separated list of frontend origins allowed to call the API.
# Defaults to the local Streamlit dev server if unset. Add the Vite dev
# server origin (localhost:5173) too if you're running the React frontend.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
